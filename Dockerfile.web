# Multi-stage build for React Vite Frontend
FROM node:20-alpine AS build
WORKDIR /app

# Cache dependency installations
COPY client/web/package*.json ./
RUN npm ci || npm install

# Copy source and compile production distribution
COPY client/web/ ./
RUN npm run build

# Production Nginx Web Server
FROM nginx:alpine

# Generate self-signed certificate for local HTTPS support on port 443
RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/nginx.key \
    -out /etc/nginx/ssl/nginx.crt \
    -subj "/C=PH/ST=MetroManila/L=Manila/O=CoopIS/OU=IT/CN=localhost"

# Copy built frontend assets
COPY --from=build /app/dist /usr/share/nginx/html

# Copy Nginx reverse proxy configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443
STOPSIGNAL SIGQUIT

CMD ["nginx", "-g", "daemon off;"]
